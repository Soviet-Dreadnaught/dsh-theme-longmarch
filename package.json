{
  "name": "dsh-theme-longmarch",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "长征终端 — DeepSeek Harness 主题皮肤：TFR《烈焰升腾》新左派「长征 / Loji」AI 路线配色（红磷光终端 + 数据雨 + CRT 扫描线），四套部门预设各自带徽记、配色与背景纹样。",
  "author": "Soviet-Dreadnaught (https://github.com/Soviet-Dreadnaught)",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon.svg": "./icon.svg",
    "./skin.json": "./skin.json",
    "./locale/*.json": "./locale/*.json",
    "./icon.png": "./icon.png",
    "./icon@2x.png": "./icon@2x.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "skin.json",
    "locale",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "icon.png",
    "icon@2x.png",
    "README.en.md"
  ],
  "icon": "./icon.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "skin",
    "terminal",
    "crt",
    "tfr"
  ],
  "meta": {
    "title": "长征终端",
    "description": "TFR 长征 / Loji 路线主题：黑底红字终端 + 数据雨 + CRT 扫描线，含党务 / 政务 / 军委 / 国安四套部门预设。",
    "icon": "data:image/png;base64,"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT"
}
